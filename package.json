{
  "name": "anyway2codex",
  "version": "0.1.0",
  "description": "Universal local proxy for OpenAI Codex: Responses API <-> Chat Completions, multi-provider routing, fallback, vision fallback, and an admin panel.",
  "type": "module",
  "bin": {
    "anyway2codex": "dist/cli.js"
  },
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p . && node postbuild.cjs",
    "start": "node dist/cli.js --port 8799 --verbose",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "postbuild": "node postbuild.cjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "eventsource-parser": "^3.0.0",
    "mimo2codex": "0.5.29",
    "nanoid": "^5.0.7",
    "undici": "^6.19.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "license": "MIT",
  "keywords": [
    "codex",
    "openai-codex",
    "llm-proxy",
    "responses-api",
    "chat-completions",
    "deepseek",
    "qwen",
    "mimo",
    "kimi",
    "glm",
    "claude-code",
    "anthropic",
    "model-router"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/begin2019510/anyway2codex.git"
  },
  "homepage": "https://github.com/begin2019510/anyway2codex#readme",
  "bugs": {
    "url": "https://github.com/begin2019510/anyway2codex/issues"
  }
}
